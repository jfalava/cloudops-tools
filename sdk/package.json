{
  "name": "@cloudops-tools/sdk",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfalava/cloudops-tools.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./operations": "./src/operations/index.ts",
    "./clients": "./src/clients/index.ts",
    "./credentials": "./src/credentials/index.ts",
    "./services": "./src/services/index.ts",
    "./lib": "./src/lib/index.ts"
  },
  "scripts": {
    "check": "tsgo --noEmit && oxlint --fix --type-aware",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "test": "bun test ./test/unit/lib",
    "test:coverage": "bun test ./test/unit/lib --coverage",
    "test:watch": "bun test ./test/unit/lib --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "catalog:aws-sdk",
    "@aws-sdk/client-docdb": "catalog:aws-sdk",
    "@aws-sdk/client-elastic-beanstalk": "catalog:aws-sdk",
    "@aws-sdk/client-elasticache": "catalog:aws-sdk",
    "@aws-sdk/client-global-accelerator": "catalog:aws-sdk",
    "@aws-sdk/client-neptune": "catalog:aws-sdk",
    "@aws-sdk/client-rds": "catalog:aws-sdk",
    "@aws-sdk/client-route-53": "catalog:aws-sdk",
    "@aws-sdk/credential-providers": "catalog:aws-sdk",
    "@aws-sdk/types": "catalog:aws-sdk",
    "@cloudops-tools/types": "workspace:*",
    "@effect/platform": "catalog:effect",
    "distilled-aws": "0.0.21",
    "effect": "catalog:effect",
    "exceljs": "catalog:utilities",
    "json2md": "catalog:utilities",
    "otpauth": "catalog:utilities",
    "zod": "catalog:utilities"
  },
  "devDependencies": {
    "@types/bun": "catalog:types",
    "@types/json2md": "catalog:types",
    "@types/node": "catalog:types",
    "@types/progress": "catalog:types",
    "@typescript/native-preview": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "typescript": "catalog:build"
  }
}
