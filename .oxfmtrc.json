{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "experimentalSortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": ["cli/**", "sdk/**", "documentation/**", "node_modules/"]
}
