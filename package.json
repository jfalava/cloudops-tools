{
  "name": "@cloudops-tools/monorepo",
  "version": "0.2.0",
  "workspaces": {
    "packages": [
      "cli",
      "cli/npm/*",
      "sdk",
      "documentation"
    ],
    "catalogs": {
      "types": {
        "@types/bun": "1.3.9",
        "@types/node": "25.3.0",
        "@types/progress": "2.0.7",
        "@types/json2md": "1.5.4"
      },
      "effect": {
        "@effect/cli": "0.73.2",
        "effect": "3.19.19",
        "@effect/platform": "0.94.5",
        "@effect/platform-bun": "0.87.1"
      },
      "build": {
        "@typescript/native-preview": "^7.0.0-dev.20260224.1",
        "oxlint": "1.50.0",
        "oxfmt": "0.35.0",
        "oxlint-tsgolint": "^0.14.2",
        "typedoc": "0.28.17",
        "typescript": "5.9.3"
      },
      "utilities": {
        "zod": "4.3.6",
        "exceljs": "4.4.0",
        "json2md": "2.0.3",
        "otpauth": "9.5.0"
      },
      "aws-sdk": {
        "@aws-sdk/client-cloudfront": "3.996.0",
        "@aws-sdk/client-elastic-beanstalk": "3.996.0",
        "@aws-sdk/client-elasticache": "3.996.0",
        "@aws-sdk/client-global-accelerator": "3.996.0",
        "@aws-sdk/client-neptune": "3.996.0",
        "@aws-sdk/client-rds": "3.996.0",
        "@aws-sdk/client-route-53": "3.996.0",
        "@aws-sdk/credential-providers": "3.996.0",
        "@aws-sdk/types": "3.973.1"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check:catalog": "bun scripts/check-catalog-usage.ts",
    "check:global": "bun run typecheck:global && bun run lint:global && bun run format:global",
    "check:outdated": "bun scripts/check-outdated-catalog.ts",
    "cli": "cd cli && bun src/app.ts",
    "cli:build:all": "bun run --filter @cloudops-tools/cli build:all",
    "cli:build:linux": "bun run --filter @cloudops-tools/cli build:linux-x64",
    "cli:build:macos": "bun run --filter @cloudops-tools/cli build:macOS-arm",
    "cli:build:windows": "bun run --filter @cloudops-tools/cli build:windows-x64",
    "cli:check": "bun run --filter @cloudops-tools/cli check",
    "cli:format": "bun run --filter @cloudops-tools/cli format",
    "cli:lint": "bun run --filter @cloudops-tools/cli lint",
    "cli:typecheck": "bun run --filter @cloudops-tools/cli typecheck",
    "documentation:check": "bun run --filter @cloudops-tools/documentation check",
    "documentation:format": "bun run --filter @cloudops-tools/documentation format",
    "documentation:lint": "bun run --filter @cloudops-tools/documentation lint",
    "documentation:typecheck": "bun run --filter @cloudops-tools/documentation typecheck",
    "format": "oxfmt",
    "format:global": "bun run --filter @cloudops-tools/cli --filter @cloudops-tools/sdk --filter @cloudops-tools/documentation format",
    "lint:global": "bun run --filter @cloudops-tools/cli --filter @cloudops-tools/sdk --filter @cloudops-tools/documentation lint",
    "sdk:check": "bun run --filter @cloudops-tools/sdk check",
    "sdk:format": "bun run --filter @cloudops-tools/sdk format",
    "sdk:lint": "bun run --filter @cloudops-tools/sdk lint",
    "sdk:typecheck": "bun run --filter @cloudops-tools/sdk typecheck",
    "typecheck:global": "bun run --filter @cloudops-tools/cli --filter @cloudops-tools/sdk --filter @cloudops-tools/documentation typecheck"
  },
  "devDependencies": {
    "oxfmt": "catalog:build"
  }
}
