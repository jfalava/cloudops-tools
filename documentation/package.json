{
  "name": "@cloudops-tools/documentation",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation vite build",
    "cf-typegen": "wrangler types",
    "check": "tsgo --noEmit && oxlint --fix --type-aware",
    "deploy": "tsgo --noEmit && oxlint --type-aware && oxfmt && bun generate:sdk-api && NODE_OPTIONS=--no-deprecation vite build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "format": "oxfmt",
    "generate:sdk-api": "bun scripts/generate-sdk-api-docs.ts",
    "lint": "oxlint --type-aware",
    "preview": "bun run build && vite preview",
    "serve": "vite preview",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.25.4",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-devtools": "0.9.6",
    "@tanstack/react-router": "1.162.6",
    "@tanstack/react-router-devtools": "1.162.6",
    "@tanstack/react-router-ssr-query": "1.162.6",
    "@tanstack/react-start": "1.162.7",
    "@tanstack/router-plugin": "1.162.6",
    "fumadocs-core": "16.6.5",
    "fumadocs-mdx": "14.2.8",
    "fumadocs-ui": "16.6.5",
    "lucide-react": "0.575.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.1",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.5.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "catalog:types",
    "@types/json2md": "catalog:types",
    "@types/node": "catalog:types",
    "@types/progress": "catalog:types",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "catalog:build",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.1.0",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "typedoc": "catalog:build",
    "typescript": "catalog:build",
    "vite": "8.0.0-beta.13",
    "vitest": "4.0.18",
    "web-vitals": "5.1.0",
    "wrangler": "4.68.0"
  }
}
