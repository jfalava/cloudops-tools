{
  "name": "@cloudops-tools/documentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "check": "tsgo --noEmit && oxlint --fix --type-aware",
    "deploy": "tsgo --noEmit && oxlint --type-aware && oxfmt && bun generate:sdk-api && vite build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "format": "oxfmt",
    "generate:sdk-api": "bun scripts/generate-sdk-api-docs.ts",
    "lint": "oxlint --type-aware",
    "preview": "bun run build && vite preview",
    "serve": "vite preview",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.23.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.9.4",
    "@tanstack/react-router": "^1.158.0",
    "@tanstack/react-router-devtools": "^1.158.0",
    "@tanstack/react-router-ssr-query": "^1.158.0",
    "@tanstack/react-start": "^1.158.0",
    "@tanstack/router-plugin": "^1.158.0",
    "fumadocs-core": "^16.5.0",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.5.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.6",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "catalog:types",
    "@types/json2md": "catalog:types",
    "@types/node": "catalog:types",
    "@types/progress": "catalog:types",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "catalog:build",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "typedoc": "catalog:build",
    "typescript": "catalog:build",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.62.0"
  }
}
