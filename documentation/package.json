{
  "name": "@cloudops-tools/documentation",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "check": "tsgo --noEmit && oxlint --fix --type-aware",
    "deploy": "tsgo --noEmit && oxlint --type-aware && oxfmt && bun generate:sdk-api && vite build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "format": "oxfmt",
    "generate:sdk-api": "bun scripts/generate-sdk-api-docs.ts",
    "lint": "oxlint --type-aware",
    "preview": "bun run build && vite preview",
    "serve": "vite preview",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.30.2",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-devtools": "0.10.0",
    "@tanstack/react-router": "1.168.8",
    "@tanstack/react-router-devtools": "1.166.11",
    "@tanstack/react-router-ssr-query": "1.166.10",
    "@tanstack/react-start": "1.167.14",
    "@tanstack/router-plugin": "1.167.10",
    "effect": "catalog:effect",
    "fumadocs-core": "16.7.7",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.7.7",
    "lucide-react": "1.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.2",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "catalog:types",
    "@types/json2md": "catalog:types",
    "@types/node": "catalog:types",
    "@types/progress": "catalog:types",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "catalog:build",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.0.1",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "typedoc": "catalog:build",
    "typescript": "catalog:build",
    "vite": "8.0.5",
    "vitest": "4.1.2",
    "web-vitals": "5.2.0",
    "wrangler": "4.78.0"
  }
}
